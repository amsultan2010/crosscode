# Same Supabase project as the rest of Crosscode (see README.md's auth section).
# Vite only exposes env vars prefixed VITE_ to browser code, so these mirror
# SUPABASE_URL / SUPABASE_ANON_KEY under that prefix.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon public key>"

# Coordination service base URL (same service the daemon talks to).
VITE_SERVICE_URL="http://127.0.0.1:8788"

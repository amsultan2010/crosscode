{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node ../../scripts/build-serverless.mjs && npm run build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" },
    { "source": "/v1/(.*)", "destination": "/api/[...path]" },
    { "source": "/join/(.*)", "destination": "/join.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30,
      "runtime": "nodejs24.x"
    }
  }
}

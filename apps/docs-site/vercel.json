{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node ../../scripts/build-serverless.mjs && npm run build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" },
    { "source": "/v1/(.*)", "destination": "/api/[...path]" },
    { "source": "/join/((?!assets/).*)", "destination": "/join.html" },
    { "source": "/device", "destination": "/device.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30
    }
  }
}
